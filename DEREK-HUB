table.insert(conns, Run.Heartbeat:Connect(function()
    if not S.alive or not LP.Character then return end

    if S.auto and role(LP) == "SHERIFF" then
        local m = getMurderer()
        if m and m.Character then
            local head = m.Character:FindFirstChild("Head")
            if head and inFOV(head.Position) and hasLOS(head) and tick() - S.lastFire > S.rate then
                S.lastFire = tick()
                equipGun()
                fire(m)
            end
        end
    end

    if S.knife and LP.Character then
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        local target, best = nil, kRange
        if hrp then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and p.Character and role(p) ~= "ASESINO" then
                    local o = p.Character:FindFirstChild("HumanoidRootPart")
                    if o then
                        local d = (o.Position - hrp.Position).Magnitude
                        if d < best then best = d; target = p end
                    end
                end
            end
        end
        if target and tick() - S.lastKnife > 0.3 then
            S.lastKnife = tick()
            local k = LP.Character:FindFirstChild("Knife")
                or (LP.Backpack and LP.Backpack:FindFirstChild("Knife"))
            if k then
                if k.Parent ~= LP.Character and LP.Character:FindFirstChild("Humanoid") then
                    pcall(function() LP.Character.Humanoid:EquipTool(k) end)
                end
                pcall(function() k:Activate() end)
            end
        end
    end
end))

