local function mkToggle(text, parent, cb)
    local b = nw("TextButton", {
        Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.btn,
        Text = "✘  " .. text, TextColor3 = C.txt, Font = Enum.Font.GothamBold,
        TextSize = 13, BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left
    }, parent)
    nw("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
    nw("UIPadding", { PaddingLeft = UDim.new(0, 10) }, b)
    local on = false
    table.insert(conns, b.MouseButton1Click:Connect(function()
        on = not on
        b.Text = (on and "✔  " or "✘  ") .. text
        b.BackgroundColor3 = on and C.g or C.btn
        cb(on)
    end))
    return b
end
local function mkButton(text, parent, cb)
    local b = nw("TextButton", {
        Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.btn,
        Text = text, TextColor3 = C.txt, Font = Enum.Font.GothamBold,
        TextSize = 13, BorderSizePixel = 0
    }, parent)
    nw("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
    table.insert(conns, b.MouseButton1Click:Connect(cb))
    return b
end
local function mkLabel(text, parent)
    return nw("TextLabel", {
        Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
        Text = text, TextColor3 = Color3.fromRGB(170, 170, 180),
        Font = Enum.Font.Gotham, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)
end
local function mkBox(text, parent)
