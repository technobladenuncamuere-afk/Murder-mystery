-- ===================== ROLES =====================
local function role(p)
    local c = p.Character
    if c then
        if c:FindFirstChild("Knife") then return "ASESINO" end
        if c:FindFirstChild("Gun") or c:FindFirstChild("Revolver") then return "SHERIFF" end
    end
    local b = p:FindFirstChild("Backpack")
    if b then
        if b:FindFirstChild("Knife") then return "ASESINO" end
        if b:FindFirstChild("Gun") or b:FindFirstChild("Revolver") then return "SHERIFF" end
    end
    return "INOCENTE"
end
local function colOf(r)
    if r == "ASESINO" then return C.r end
    if r == "SHERIFF" then return Color3.fromRGB(70,140,255) end
    return C.g
end
local function getMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and role(p) == "ASESINO" then return p end
    end
end

-- ===================== ESP =====================
local function addESP(p)
    if esps[p] or p == LP then return end
    local c = p.Character
    if not c then return end
    local head = c:FindFirstChild("Head")
    if not head then return end
    local bg = nw("BillboardGui", {
        Name = "DerekESP", Size = UDim2.new(0, 220, 0, 52),
        StudsOffset = Vector3.new(0, 2.6, 0), AlwaysOnTop = true, MaxDistance = 2000
    }, head)
    local nm = nw("TextLabel", {
        Size = UDim2.fromScale(1, 0.5), BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold, TextScaled = true,
        TextStrokeTransparency = 0, Text = p.Name, TextColor3 = C.txt
    }, bg)
    local rl = nw("TextLabel", {
        Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromScale(1, 0.5),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBlack,
        TextScaled = true, TextStrokeTransparency = 0, Text = "..."
    }, bg)
    esps[p] = bg
    task.spawn(function()
        while esps[p] and bg.Parent do
            local r = role(p)
            rl.Text = r
            rl.TextColor3 = colOf(r)
            task.wait(0.4)
        end
    end)
end
local function clearESP()
    for p, b in pairs(esps) do
        if b then b:Destroy() end
        esps[p] = nil
    end
end

-- ===================== HITBOX =====================
local function restoreOne(p)
    local o = hbOrig[p]
    if not o then return end
    local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Size = o.sz; hrp.CanCollide = o.cc; hrp.Transparency = o.tr
    end
    hbOrig[p] = nil
end
local function applyOne(p)
    local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not hbOrig[p] then
        hbOrig[p] = { sz = hrp.Size, cc = hrp.CanCollide, tr = hrp.Transparency }
    end
    local n = S.hbSize
    hrp.Size = Vector3.new(n, n, n)
    hrp.CanCollide = false
    hrp.Transparency = 0.65
end
local function updateHB()
    if not S.hbMode then
        for p in pairs(hbOrig) do restoreOne(p) end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            if S.hbMode == "all" or role(p) == "ASESINO" then
                applyOne(p)
            else
                restoreOne(p)
            end
        end
    end
end

-- ===================== DISPARO =====================
local function shootRemote()
    for _, n in ipairs({ "Shoot", "ShootGun", "ShootEvent" }) do
        local r = RS:FindFirstChild(n)
        if r and r:IsA("RemoteEvent") then return r end
        local f = RS:FindFirstChild("Remotes")
        if f then
            local r2 = f:FindFirstChild(n)
            if r2 and r2:IsA("RemoteEvent") then return r2 end
        end
    end
end
local function equipGun()
    local c = LP.Character
    if not c or c:FindFirstChild("Gun") then return end
    local bp = LP:FindFirstChild("Backpack")
    local g = bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver"))
    if g and c:FindFirstChild("Humanoid") then c.Humanoid:EquipTool(g) end
end
local function fire(target)
    local c = target.Character
    local head = c and c:FindFirstChild("Head")
    if not head then return end
    local rem = shootRemote()
    if not rem then return end
    local origin = cam().CFrame.Position
    local dir = (head.Position - origin).Unit
    pcall(function() rem:FireServer(head, origin, dir) end)
    pcall(function() rem:FireServer(head, origin) end)
end
local function inFOV(pos)
    local ok, sp, on = pcall(function() return cam():WorldToViewportPoint(pos) end)
    if not ok or not on then return false end
    local ctr = cam().ViewportSize / 2
    return (Vector2.new(sp.X, sp.Y) - ctr).Magnitude <= S.fov
end
local function hasLOS(part)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { LP.Character, part.Parent }
    local hit = workspace:Raycast(cam().CFrame.Position, part.Position - cam().CFrame.Position, rp)
    return hit == nil
end

